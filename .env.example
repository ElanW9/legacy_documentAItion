# Copy to .env for local development. NEVER commit .env (it is gitignored).
# In CI these come from GitHub Actions secrets (*) and repository variables.

# --- LLM ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=<key value>
GEMINI_MODEL=

# --- Confluence ---
PUBLISH_MODE=rest
ATLASSIAN_EMAIL=test@example.com
ATLASSIAN_TOKEN=<key value>
CONFLUENCE_SITE=spacename.atlassian.net
CONFLUENCE_SPACE=LD
CONFLUENCE_PARENT_ID=123456789

# --- Optional ---
SOURCE_BASE_URL=
GEMINI_THINKING_LEVEL=
LLM_TEMPERATURE=
CHUNK_THRESHOLD_LINES=
