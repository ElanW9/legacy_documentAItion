# Copy to .env for local development. NEVER commit .env (it is gitignored).
# In CI these come from GitHub Actions secrets (*) and repository variables.
# Keys stay empty here on purpose: an empty value means "not set", so a copied
# file fails fast with a clear message instead of sending a placeholder.

# --- LLM ---
# gemini | openrouter | fake (fake = offline, no API calls)
LLM_PROVIDER=
# (*) from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# e.g. gemini-3.8-flash
GEMINI_MODEL=
# (*) from https://openrouter.ai/settings/keys (used with LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
# e.g. nvidia/nemotron-3-super-120b-a12b:free (needs structured_outputs support)
OPENROUTER_MODEL=

# --- Confluence ---
# rest | mcp
PUBLISH_MODE=
# (*) e.g. you@example.com
ATLASSIAN_EMAIL=
# (*) classic API token from https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_TOKEN=
# e.g. yourname.atlassian.net
CONFLUENCE_SITE=
# space key, e.g. LD
CONFLUENCE_SPACE=
# numeric id of the parent page, e.g. 123456789
CONFLUENCE_PARENT_ID=

# --- Optional ---
# e.g. https://github.com/<owner>/<repo>/blob (enables evidence links)
SOURCE_BASE_URL=
# minimal | low | medium | high (default: model default)
GEMINI_THINKING_LEVEL=
# default: model default (recommended for Gemini 3)
LLM_TEMPERATURE=
# default: 150
CHUNK_THRESHOLD_LINES=
